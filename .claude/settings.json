{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge)",
      "Bash(gh api *pulls/*/merge *)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(gh api graphql *enablePullRequestAutoMerge*)",
      "Bash(gh api *repos/*/rulesets*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)"
    ]
  }
}
